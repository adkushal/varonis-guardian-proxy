# OpenAI key required for allowed (non-blocked) prompts to reach the model.
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# Guardian
# mock = no GPU (default). vllm = requires Compose profile `gpu` + NVIDIA.
GUARDIAN_MODE=mock
GUARDIAN_MODEL=ibm-granite/granite-guardian-4.1-8b
GUARDIAN_CRITERIA=harm,profanity
# 1 = block with HTTP 503 when Guardian can't give a verdict (recommended).
# 0 = let the prompt through when Guardian is down.
GUARDIAN_FAIL_CLOSED=1
VLLM_BASE_URL=http://vllm:8000/v1

# Optional: Hugging Face token (the Guardian model is not gated, so usually not needed)
# HUGGING_FACE_HUB_TOKEN=
